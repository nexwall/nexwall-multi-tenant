{
  "uid": "liz0yRCZz",
  "title": "Logs",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "hostname",
        "type": "textbox",
        "label": "Hostname",
        "current": { "text": ".*", "value": ".*" },
        "query": ""
      },
      {
        "name": "level",
        "type": "textbox",
        "label": "Level",
        "current": { "text": ".*", "value": ".*" },
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Firewall logs",
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true
      },
      "targets": [
        {
          "expr": "{job=\"syslog\", hostname=~\"$hostname\", level=~\"$level\"}"
        }
      ]
    }
  ]
}
