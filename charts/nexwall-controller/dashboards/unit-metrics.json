{
  "uid": "W3S__804z",
  "title": "Unit Metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "unit",
        "type": "textbox",
        "label": "Unit",
        "current": { "text": "", "value": "" },
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Unit reachable (netdata target up)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "up{unit=\"$unit\", metrics_type=\"netdata\"}",
          "legendFormat": "netdata"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unit reachable (telegraf target up)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "up{unit=\"$unit\", metrics_type=\"telegraf\"}",
          "legendFormat": "telegraf"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scrape duration - this unit",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "scrape_duration_seconds{unit=\"$unit\"}",
          "legendFormat": "{{metrics_type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "text",
      "title": "Note",
      "gridPos": { "h": 4, "w": 16, "x": 0, "y": 14 },
      "options": {
        "mode": "markdown",
        "content": "This dashboard is a minimal placeholder wired to the same UID the controller UI already links to (`W3S__804z`), so the \"view metrics\" button in Unit Manager works end-to-end. It only proves connectivity (`up`) and scrape timing, because we don't have the real netdata/telegraf metric names Nethesis' proprietary dashboard uses. Once a unit is registered and actually scraping, replace these panels with real CPU/memory/network/disk panels using the metric names netdata/telegraf actually expose (check `/prometheus/metrics` on a connected unit, port 19999 or 9273)."
      }
    }
  ]
}
